            "user": "1"
          },
          "expected": "success"
        }
      ]
    },
    {
      "description": "User 1 repays the AGT borrow after one year",
      "actions": [
        {
          "name": "mint",
          "args": {
            "reserve": "AGT",
            "amount": "20",
            "user": "1"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {
            "reserve": "AGT",
            "user": "1"
          },
          "expected": "success"
        },
        {
          "name": "repay",
          "args": {
            "reserve": "AGT",
            "amount": "-1",
            "user": "1",
            "onBehalfOf": "1",
            "borrowRateMode": "variable",
            "timeTravel": "365"
          },
          "expected": "success"
        }
      ]
    },
    {
      "description": "User 0 deposits 1000 USDT, user 1 deposits 1000 USDC as collateral and borrows 500 USDT at variable rate",
      "actions": [
        {
          "name": "mint",
          "args": {
            "reserve": "USDT",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {

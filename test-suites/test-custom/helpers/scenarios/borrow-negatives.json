{
  "title": "LendingPool: Borrow negatives (reverts)",
  "description": "Test cases for borrow failures including stable borrow (disabled in custom market).",
  "stories": [
    {
      "description": "User 0 deposits 1000 USDC, user 1 deposits 100 OXAU as collateral and tries to borrow 500 USDC with rate mode NONE (revert expected)",
      "actions": [
        {
          "name": "mint",
          "args": {
            "reserve": "USDC",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {
            "reserve": "USDC",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "deposit",
          "args": {
            "reserve": "USDC",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "mint",
          "args": {
            "reserve": "OXAU",
            "amount": "100",
            "user": "1"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {
            "reserve": "OXAU",
            "user": "1"
          },
          "expected": "success"
        },
        {
          "name": "deposit",
          "args": {
            "reserve": "OXAU",
            "amount": "100",
            "user": "1"
          },
          "expected": "success"
        },
        {
          "name": "borrow",
          "args": {
            "reserve": "USDC",
            "amount": "500",
            "borrowRateMode": "none",
            "user": "1"
          },
          "expected": "revert",
          "revertMessage": "Invalid interest rate mode selected"
        }
      ]
    },

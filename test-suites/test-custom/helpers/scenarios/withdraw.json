{
  "title": "LendingPool: Withdraw",
  "description": "Test cases for withdraw function with AGT, USDC, USDT.",
  "stories": [
    {
      "description": "User 0 Deposits 1000 AGT in an empty reserve",
      "actions": [
        {
          "name": "mint",
          "args": {
            "reserve": "AGT",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {
            "reserve": "AGT",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "deposit",
          "args": {
            "reserve": "AGT",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        }
      ]
    },
    {
      "description": "User 0 withdraws half of the deposited AGT",
      "actions": [
        {
          "name": "withdraw",
          "args": {
            "reserve": "AGT",
            "amount": "500",
            "user": "0"
          },
          "expected": "success"
        }
      ]
    },
    {
      "description": "User 0 withdraws remaining half of the deposited AGT",
      "actions": [
        {
          "name": "withdraw",
          "args": {
            "reserve": "AGT",
            "amount": "-1",
            "user": "0"
          },
          "expected": "success"
        }
      ]
    },

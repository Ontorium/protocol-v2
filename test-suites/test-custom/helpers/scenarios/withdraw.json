          "args": {
            "reserve": "AGT",
            "amount": "100",
            "user": "7"
          },
          "expected": "success"
        },
        {
          "name": "borrow",
          "args": {
            "reserve": "USDC",
            "amount": "800",
            "user": "7",
            "borrowRateMode": "variable"
          },
          "expected": "success"
        },

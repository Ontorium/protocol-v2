{
  "title": "LendingPool: Withdraw",
  "description": "Test cases for withdraw function with OXAU, USDC, USDT.",
  "stories": [
    {
      "description": "User 0 Deposits 1000 OXAU in an empty reserve",
      "actions": [
        {
          "name": "mint",
          "args": {
            "reserve": "OXAU",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {
            "reserve": "OXAU",
            "user": "0"
          },
          "expected": "success"
        },
        {
          "name": "deposit",
          "args": {
            "reserve": "OXAU",
            "amount": "1000",
            "user": "0"
          },
          "expected": "success"
        }
      ]
    },
    {
      "description": "User 0 withdraws half of the deposited OXAU",
      "actions": [
        {
          "name": "withdraw",
          "args": {
            "reserve": "OXAU",
            "amount": "500",
            "user": "0"
          },
          "expected": "success"
        }
      ]
    },
    {
      "description": "User 0 withdraws remaining half of the deposited OXAU",
      "actions": [
        {
          "name": "withdraw",
          "args": {
            "reserve": "OXAU",
            "amount": "-1",
            "user": "0"
          },
          "expected": "success"
        }
      ]
    },

        {
          "name": "deposit",
          "args": {
            "reserve": "OXAU",
            "amount": "5",
            "user": "7"
          },
          "expected": "success"
        },
        {
          "name": "borrow",
          "args": {
            "reserve": "USDC",
            "amount": "800",
            "user": "7",
            "borrowRateMode": "variable"
          },
          "expected": "success"
        },
        {
          "name": "withdraw",
          "args": {
            "reserve": "USDT",
            "amount": "-1",
            "user": "7"
          },
          "expected": "revert",
          "revertMessage": "Transfer cannot be allowed."
        }

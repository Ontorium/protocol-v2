      "description": "User 6 deposits 1000 USDC, user 7 deposits 1000 USDT and 5 OXAU, borrows 800 USDC at variable. User 7 tries to withdraw all USDT (fails due to HF)",
      "actions": [
        {
          "name": "mint",
          "args": {
            "reserve": "USDC",
            "amount": "1000",
            "user": "6"
          },
          "expected": "success"
        },
        {
          "name": "approve",
          "args": {
            "reserve": "USDC",
            "user": "6"
          },
          "expected": "success"

          "args": {
            "reserve": "USDT",
            "amount": "1000",
            "user": "7"
          },
          "expected": "success"
        },
        {
          "name": "mint",
          "args": {
            "reserve": "OXAU",
            "amount": "5",
            "user": "7"
          },
          "expected": "success"

          },
          "expected": "success"
        },
        {
          "name": "deposit",
          "args": {
            "reserve": "USDT",
            "amount": "1000",
            "user": "4"
          },
          "expected": "success"
        },
        {
          "name": "withdraw",
          "args": {
            "reserve": "USDT",
